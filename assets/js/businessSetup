interface site {
    rent: number;
    bond: number;
    frontage: number;
    depth: number;
    area: number;
    naturalFlow: number;
    smokeFree: boolean;
    renovationCompletion: number;
    storey: number;
    forlease: boolean;
    forSale: boolean;
    type: shopType;
}

type shopType =
  | "shop"
  | "school"
  | "factory"
  | "residential"
  | "office"
  | "station"
  | "tourism";

function generateType(): shopType {
  const r = Math.random();

  if (r < 0.6) return "shop" ;
  if (r < 0.68) return "school" ;
  if (r < 0.69) return "factory" ;
  if (r < 0.72) return "residential" ;
  if (r < 0.84) return "office" ;
  if (r < 0.89) return "station" ;
  return "tourism";
}


